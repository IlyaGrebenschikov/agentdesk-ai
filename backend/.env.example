# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database
DB_DRIVERNAME=postgresql+asyncpg
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=agentdesk
DB_PASSWORD=agentdesk
DB_DATABASE=agentdesk
DB_HEALTH_CHECK_TIMEOUT=5

# Cache (Redis)
CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_PASSWORD=agentdesk

# Password hashing
PWD_HASH_MAX_THREADS=4

# CORS
CORS_ORIGINS=["*"]
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# JWT
JWT_ALGORITHM=RS256
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_MINUTES=43200
# Directory with jwt-private.pem and jwt-public.pem (default: backend/.certs)
# JWT_CERTS_DIR=/absolute/path/to/certs
